# Everything here is optional. ToolNest builds and runs with no environment
# configured at all — content lives in the repository, not in a database.

# Public site URL, used for canonicals, sitemap and Open Graph.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://toolnest.example"

# Optional integrations. Each stays completely inert while unset.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=""
